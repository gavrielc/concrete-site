---
import Testimonials from "../components/Testimonials.astro";
import PageLayout from "../layouts/PageLayout.astro";
import Clients from "../components/Clients";
import pages from "virtual:cms/pages";
---

<PageLayout
    pageTitle={pages.clients.seoTitle}
    description={pages.clients.seoDescription}
    title={pages.clients.heading}
    subTitle={pages.clients.intro}
>
    <section class="logos">
        <Clients client:idle/>
    </section>
    <Testimonials />
</PageLayout>

<style>
    .logos {
        display: flex;
        flex-direction: column;
    }

    .logos :global(.tags) {
        display: none;
    }

    .logos :global(.tag) {
        padding: 16px 24px;
        border-radius: 16px;
        border: none;
        font-family: 'Inter';
        font-weight: 500;
        font-size: 13px;
        color: #7022FB;
        background: #F8FAFC;
        cursor: pointer;
    }

    .logos :global(.tag.active) {
        background: rgba(112, 34, 251, 0.2);
    }

    .logos :global(.logo) {
        max-height: 80px;
        max-width: 184px;
    }

    .logos :global(.factify-logo) {
        width: 203px;
        max-width: 203px;
    }

    .logos :global(.echo-logo) {
        width: 160px;
        max-width: 160px;
    }

    .logos :global(.invert-logo) {
        filter: invert(1);
    }

    .logos :global(.logos-wrapper) {
        display: flex;
        gap: 36px 32px;
        flex-wrap: wrap;
        justify-content: center;
    }

    .logos :global(a) {
        width: 276px;
        height: 140px;
        background: #F8FAFC;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
</style>
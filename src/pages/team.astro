---
import PageLayout from "../layouts/PageLayout.astro";
import TeamCard from "../components/TeamCard.astro";
import team from "virtual:cms/team";
import pages from "virtual:cms/pages";



---

<PageLayout
    pageTitle={pages.team.seoTitle}
    description={pages.team.seoDescription}
    title={pages.team.heading}
    subTitle={pages.team.intro}
>
    <section class="team">
        {team.map((e) => <TeamCard {...e}/>)}
    </section>
</PageLayout>

<style>
    .team {
        flex-wrap: wrap;
        gap: 44px 64px;
        align-items: flex-start;
    }


</style>
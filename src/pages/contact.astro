---
import PageLayout from "../layouts/PageLayout.astro";
import bullet from '../assets/icons/bullet.svg';
import pages from "virtual:cms/pages";
---

<PageLayout
    pageTitle={pages.contact.seoTitle}
    description={pages.contact.seoDescription}
>
    <section class='contact-hero'>
        <h3>{pages.contact.heading}</h3>
        <a class="email-button" href={`mailto:${pages.contact.email}`}>{pages.contact.email}</a>
    </section>
    <section class="offices">
        {pages.contact.offices.map((office) => (
            <div class="office-location">
                {office.mapSrc && <iframe src={office.mapSrc} width="100%" height="380" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title={`Map of ${office.name}`}></iframe>}
                <div class="location-desc">
                    <img src={bullet.src} alt="" />
                    <p class="name">{office.name}</p>
                    <p class="address">{office.address}</p>
                </div>
            </div>
        ))}
    </section>
</PageLayout>

<style lang="scss">
    @mixin normal-text {
        font-family: 'Inter';
        font-size: 16px;
        color: rgba(0, 0, 0, 0.6);
    }

    .contact-hero {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        padding-top: 110px;
        padding-bottom: 40px;

        h3 {
            margin: 0 0 32px;
        }

        .email-button {
            display: inline-block;
            padding: 16px 40px;
            background-color: #7022FB;
            color: #fff;
            font-family: 'Outfit';
            font-weight: 600;
            font-size: 18px;
            text-decoration: none;
            border-radius: 8px;
            transition: background-color 0.2s;

            &:hover {
                background-color: #5a1ad4;
            }
        }
    }

    .offices {
        gap: 32px;
        flex-wrap: wrap;
    }

    .office-location {
        flex: 1 1 385px;
        min-width: 0;

        .map {
            border-radius: 16px;
        }

        .location-desc {
            position: relative;
            margin-top: 16px;
        }

        .address {
            @include normal-text;
        }

        .name, .address {
            margin: 0 0 8px 20px;
        }

        img {
            position: absolute;
            top: 10px;
        }
    }

    .name {
        font-family: 'Outfit';
        font-weight: 600;
        font-size: 24px;
        color: #7022FB;
        margin: 0;
    }

    @media screen and (max-width: 827px) {
        .contact-hero {
            padding-top: 40px;
        }
    }

    @media screen and (max-width: 367px) {
        .office-location {
            flex: 1 0 200px;
        }
    }
</style>

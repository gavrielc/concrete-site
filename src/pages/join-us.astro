---
import LinkButton from "../components/LinkButton.astro";
import PageLayout from "../layouts/PageLayout.astro";
import positions from "virtual:cms/positions";
import pages from "virtual:cms/pages";


const joinUs = pages.joinUs;
const teamImgSrc = joinUs.banner ? `url(${joinUs.banner.url})` : "none";
const teamImgRatio = joinUs.banner ? joinUs.banner.width / joinUs.banner.height : 1.5;

---

<PageLayout
    pageTitle={pages.joinUs.seoTitle}
    description={pages.joinUs.seoDescription}
    title={pages.joinUs.heading}
    subTitle={pages.joinUs.intro}
>
    {positions.length > 0 && (<section class="positions">
        <h3>{joinUs.positionsHeading}</h3>
        <div class="card-wrapper">
            {positions.map((job) => (
              <div class="card">
                <div class="job-title">{job.title}</div>
                <div class="location txt">{job.location}</div>
                <details class="job-details">
                    <summary class="txt">View Role Description</summary>
                    <div class="job-description">
                        <h5>Role Overview</h5>
                        <p>{job.overview}</p>
                        {(job.sections || []).map((section) => (
                          <>
                            <h5>{section.heading}</h5>
                            <ul>
                                {(section.points || []).map((point) => <li>{point}</li>)}
                            </ul>
                          </>
                        ))}
                    </div>
                </details>
                <LinkButton class="apply-btn" href={`mailto:${job.applyEmail}?subject=Application for ${job.title} Position`} type='hollow' openInNewWindow>Apply now</LinkButton>
              </div>
            ))}
        </div>
    </section>)}
    <section class="hero-section">
        <div class="hero">
          {joinUs.bannerText}
        </div>
    </section>
    <section class="difference">
      <h3>{joinUs.benefitsHeading}</h3>
      <div class="difference-cards">
        {(joinUs.benefits || []).map((benefit) => (
          <div class="difference-card">
            {benefit.icon && <img src={benefit.icon} alt={`${benefit.title} icon`}/>}
            <h4>{benefit.title}</h4>
            <p>{benefit.text}</p>
          </div>
        ))}
      </div>
      <LinkButton href="/team">{joinUs.benefitsButtonLabel}</LinkButton>
  </section>
</PageLayout>

<style define:vars={{teamImgSrc, teamImgRatio}}>
    .positions, .hero-section, .difference {
        flex-direction: column;
        align-items: center;
        padding-top: 0;
    }

    .card-wrapper {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(384px, 100%), 1fr));
      gap: 32px;
      width: 100%;
    }

    .card {
      background-color: rgba(248, 250, 252, 1);
      border-radius: 32px;
      display: flex;
      flex-direction: column;
      height: auto;
      min-height: 240px;
      padding: 24px;
      align-self: start;
    }

    .apply-btn {
      margin-top: auto;
    }

    .job-title, h4 {
      font-family: 'Outfit';
      font-weight: 600;
      font-size: 24px;
      color: #7022FB;
    }

    .job-title {
      margin-bottom: 16px;
    }

    h4 {
      margin: 10px 0;
    }

    .txt {
      color: rgba(0, 0, 0, 0.6);
      font-family: "Inter", Helvetica;
    }

    .location {
      font-weight: 600;
      margin-bottom: 8px;
    }

    .hero-section, .difference {
      padding-top: 0;
    }

    .hero {
      aspect-ratio: var(--teamImgRatio);
      background-size: cover;
      border-radius: 32px;
      background-image: linear-gradient(76.32deg, rgba(112, 34, 251, 0.6) 0%, rgba(112, 34, 251, 0) 100%), var(--teamImgSrc);
      font-size: 36px;
      line-height: 41.4px;
      font-weight: 600;
      letter: -1%;
      font-family: 'Outfit';
      color: white;
      padding: 40px 40% 40px 40px;
      display: flex;
      align-items: end;
    }

    .difference h3 {
      margin: 0 0 30px;
      text-align: center;
    }

    .difference-cards {
      display: flex;
      gap: 32px;
      flex-wrap: wrap;
      justify-content: center;
      margin-bottom: 32px;
    }

    .difference-card {
      background: rgba(248, 250, 252, 1);
      border-radius: 32px;
      padding: 24px;
      flex: 384px 0 1;
    }

    p {
      font-family: "Inter";
      font-size: 16px;
      color: rgba(0, 0, 0, 0.6);
      line-height: 23.2px;
    }

    .job-details {
      margin: 16px 0;
    }

    .job-details summary {
      cursor: pointer;
      color: #7022FB;
      font-weight: 500;
      margin-bottom: 16px;
      display: flex;
      align-items: center;
    }

    .job-details summary::before {
      content: "►";
      margin-right: 8px;
      font-size: 12px;
    }

    .job-details[open] summary::before {
      content: "▼";
    }

    .job-description {
      padding: 16px 0;
      margin-right: 32px;
    }

    .job-description h5 {
      font-family: 'Outfit';
      font-weight: 600;
      font-size: 18px;
      color: #7022FB;
      margin: 24px 0 16px;
    }

    .job-description h5:first-child {
      margin-top: 0;
    }

    .job-description p, .job-description li {
      color: rgba(0, 0, 0, 0.6);
      font-family: "Inter";
      font-size: 16px;
      line-height: 24px;
      max-width: none;
    }

    .job-description ul {
      list-style-type: disc;
      margin: 0 0 0 20px;
      padding: 0;
    }

    .job-description li {
      margin-bottom: 8px;
      padding-left: 8px;
    }

    .job-description li:last-child {
      margin-bottom: 0;
    }

    @media screen and (max-width: 680px) {
      .hero {
        padding: 32px;
        font-size: 20px;
        line-height: 23px;
        aspect-ratio: 2 / 3;
        background-position: center;
      }
    }
</style>
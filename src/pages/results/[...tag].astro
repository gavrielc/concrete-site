---
import PageLayout from "../../layouts/PageLayout.astro";
import Results, {tags} from "../../components/results";
import pages from "virtual:cms/pages";

export function getStaticPaths() {
    return [
        {params: {tag: undefined}}, 
        ...tags.map(t => ({
            params: { tag: t.value }
        }))
    ];
}

const { tag } = Astro.params;
---

<PageLayout
    pageTitle={pages.coverage.seoTitle}
    description={pages.coverage.seoDescription}
    title={pages.coverage.heading}
    subTitle={pages.coverage.intro}
    canonicalUrl="https://concrete.media/results/"
>
    <section class="results" id="resultsSection">
        <Results client:idle tag={tag}/>
    </section>
</PageLayout>

<script>
    const searchParams = new URLSearchParams(window.location.search);
    const isEditMode = searchParams.get('edit') === 'true';
    if (isEditMode) {
        document.getElementById('resultsSection').classList.add('edit-mode');
    }
</script>

<style>
    .results {
        display: flex;
        flex-direction: column;
    }

    .results.edit-mode {
        width: 100%;
        padding: 84px 48px;
        max-width: 100vw;
    }
</style>
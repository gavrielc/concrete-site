---
import TestimonialCard from "./TestimonialCard.astro";
import testimonials from "virtual:cms/testimonials";


---

<section class="testimonials" id="testimonials">
    <h3>What our clients say</h3>
    <div class="cards-wrapper">
        {testimonials.map(t => <TestimonialCard {...t} />)}
    </div>
    <nav>
        {testimonials.map((_, i) => <div class:list={["dot", {active: i == 0}]} ><div class="inner-dot"/></div>)}
    </nav>
</section>

<script defer is:inline>
    const container = document.querySelector('.cards-wrapper');
    const buttons = [...document.querySelectorAll('.dot')];
    const GAP = 32;

    function show(i) {
        container.scrollTo({behavior: 'smooth', left: (container.clientWidth + GAP) * i});
        buttons.forEach((b, j) => b.classList.toggle('active', i == j));
    }

    // One dot per page of cards, so any number of testimonials stays reachable.
    function updateDots() {
        const card = container.querySelector('.testimonial-card');
        if (!card) return;
        const perPage = Math.max(1, Math.round((container.clientWidth + GAP) / (card.offsetWidth + GAP)));
        const pages = Math.ceil(buttons.length / perPage);
        buttons.forEach((b, i) => (b.style.display = i < pages ? '' : 'none'));
        container.parentElement.querySelector('nav').style.display = pages > 1 ? '' : 'none';
        if (buttons.findIndex((b) => b.classList.contains('active')) >= pages) show(0);
    }

    buttons.forEach((button, i) => button.addEventListener('click', () => show(i)));
    window.addEventListener('resize', updateDots);
    updateDots();
</script>

<style>
	
    #testimonials {
		flex-direction: column;
		padding-top: 0;
	}

	#testimonials > div {
		gap: 32px;
		width: 1216px;
		overflow-x: hidden;
		display: flex;
		margin: 36px 112px;
		align-items: center;
	}

	#testimonials h3 {
		margin: 0;
	}

    nav {
        display: flex;
    }

    .dot {
        cursor: pointer;
        padding: 6px;
    }

    .inner-dot {
        height: 12px;
        width: 12px;
        background: rgba(71, 85, 105, 0.3);
        border-radius: 50%;
        cursor: pointer;
    }

    .dot.active .inner-dot {
        background: #7022FB;
    }

    @media screen and (max-width: 1270px) {
        #testimonials > div {
            width: 800px;
        }
	}

    @media screen and (max-width: 832px) {
        #testimonials > div {
            width: 384px;
        }
	}

    @media screen and (max-width: 400px) {
		#testimonials > div {
			width: calc(100vw - 16px);
		}
	}
</style>